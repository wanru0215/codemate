{
  "version": 2,
  "builds": [
    {
      "src": "api/execute_python.py",
      "use": "@vercel/python"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/execute_python",
      "dest": "/api/execute_python"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
